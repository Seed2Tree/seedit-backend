# 복사해서 .env 로 쓰고 실제 값 채우기 (.env 는 커밋 금지)
# Spring 은 .env 를 자동으로 읽지 않습니다 -> 아래 둘 중 하나:
#   1) IntelliJ 실행 구성 / OS 환경변수로 등록
#   2) 의존성 추가: me.paulschwarz:spring-dotenv (.env 자동 로딩)
# (등록 안 하면 application.yml 의 기본값으로 동작합니다)

# ===== Database (MySQL) =====
DB_URL=jdbc:mysql://localhost:3306/seedit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# ===== Server =====
SERVER_PORT=8080

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-long-random-secret-key-32bytes+
JWT_EXPIRATION=3600000

# ===== CORS (프론트 출처) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== AI / RSS =====
AI_API_KEY=
RSS_FEED_URL=https://www.hankyung.com/feed/economy
